{
  "name": "sip-and-nest",
  "version": "1.0.0",
  "private": true,
  "description": "Sip & Nest — neighborhood cafe site for Sai Reddy, Chicago.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler d1 migrations apply sip-and-nest --remote && wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply sip-and-nest --local",
    "db:migrate:remote": "wrangler d1 migrations apply sip-and-nest --remote"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
